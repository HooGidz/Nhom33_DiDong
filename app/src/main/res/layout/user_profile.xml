<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Phần Header: Nút Quay lại - Tiêu đề - Menu -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#EAECEF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:src="@drawable/icons8_back_24"
                    app:tint="#333333" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Hồ sơ"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />

            </RelativeLayout>

        <!-- Phần Thông tin người dùng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_change_avatar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="#FFCCBC"
                app:cardCornerRadius="40dp"
                app:cardElevation="0dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hoang"
                    android:textColor="#222222"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_bio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tôi yêu đồ ăn nhanh"
                    android:textColor="#999999"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nhóm 1: Thông tin cá nhân & Địa chỉ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <!-- Thông tin cá nhân -->
                <RelativeLayout
                    android:id="@+id/btn_info_container"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="15dp">
                    <ImageView android:id="@+id/icon1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerVertical="true"
                        android:src="@android:drawable/ic_menu_info_details"
                        app:tint="#FF7043" />
                    <TextView android:id="@+id/btn_info_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="20dp"
                        android:layout_toEndOf="@id/icon1"
                        android:text="Thông tin cá nhân"
                        android:textColor="#444444"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="›"
                        android:textColor="#CCCCCC"
                        android:textSize="22sp" />
                </RelativeLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="60dp" android:background="#F0F0F0" />
                <!-- Địa chỉ -->
                <RelativeLayout
                    android:id="@+id/btn_address_container"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="15dp">
                    <ImageView android:id="@+id/icon2" android:layout_width="24dp" android:layout_height="24dp" android:layout_centerVertical="true" android:src="@android:drawable/ic_dialog_map" app:tint="#5C6BC0" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="20dp" android:layout_toEndOf="@id/icon2" android:text="Địa chỉ" android:textColor="#444444" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="›" android:textColor="#CCCCCC" android:textSize="22sp" />
                </RelativeLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nhóm 2: Giỏ hàng, Yêu thích, Thông báo, Thanh toán, Lịch sử giao hàng -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <!-- Giỏ hàng -->
                <RelativeLayout
                    android:id="@+id/btn_cart_container"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="15dp">
                    <ImageView android:id="@+id/icon3" android:layout_width="24dp" android:layout_height="24dp" android:layout_centerVertical="true" android:src="@android:drawable/ic_menu_add" app:tint="#42A5F5" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="20dp" android:layout_toEndOf="@id/icon3" android:text="Giỏ hàng" android:textColor="#444444" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="›" android:textColor="#CCCCCC" android:textSize="22sp" />
                </RelativeLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="60dp" android:background="#F0F0F0" />
                <!-- Yêu thích -->
                <RelativeLayout
                    android:id="@+id/btn_favorite_container"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="15dp">
                    <ImageView android:id="@+id/icon4" android:layout_width="24dp" android:layout_height="24dp" android:layout_centerVertical="true" android:src="@android:drawable/btn_star_big_off" app:tint="#AB47BC" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="20dp" android:layout_toEndOf="@id/icon4" android:text="Yêu thích" android:textColor="#444444" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="›" android:textColor="#CCCCCC" android:textSize="22sp" />
                </RelativeLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="60dp" android:background="#F0F0F0" />
                <!-- Thông báo -->
                <RelativeLayout
                    android:id="@+id/btn_notification_container"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="15dp">
                    <ImageView android:id="@+id/icon5" android:layout_width="24dp" android:layout_height="24dp" android:layout_centerVertical="true" android:src="@android:drawable/ic_popup_reminder" app:tint="#FFA726" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="20dp" android:layout_toEndOf="@id/icon5" android:text="Thông báo" android:textColor="#444444" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="›" android:textColor="#CCCCCC" android:textSize="22sp" />
                </RelativeLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="60dp" android:background="#F0F0F0" />
                <!-- Phương thức thanh toán -->
                <RelativeLayout
                    android:id="@+id/btn_payment_container"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="15dp">
                    <ImageView android:id="@+id/icon6" android:layout_width="24dp" android:layout_height="24dp" android:layout_centerVertical="true" android:src="@android:drawable/ic_menu_manage" app:tint="#26C6DA" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="20dp" android:layout_toEndOf="@id/icon6" android:text="Phương thức thanh toán" android:textColor="#444444" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="›" android:textColor="#CCCCCC" android:textSize="22sp" />
                </RelativeLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="60dp" android:background="#F0F0F0" />
                <!-- Lịch sử giao hàng -->
                <RelativeLayout
                    android:id="@+id/btn_order_history_container"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="15dp">
                    <ImageView android:id="@+id/icon_history" android:layout_width="24dp" android:layout_height="24dp" android:layout_centerVertical="true" android:src="@android:drawable/ic_menu_recent_history" app:tint="#66BB6A" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="20dp" android:layout_toEndOf="@id/icon_history" android:text="Lịch sử giao hàng" android:textColor="#444444" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="›" android:textColor="#CCCCCC" android:textSize="22sp" />
                </RelativeLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nhóm 3: Hỗ trợ, Đánh giá, Cài đặt -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <!-- Câu hỏi thường gặp -->
                <RelativeLayout
                    android:id="@+id/btn_faq_container"
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingHorizontal="15dp">
                    <ImageView android:id="@+id/icon7" android:layout_width="24dp" android:layout_height="24dp" android:layout_centerVertical="true" android:src="@android:drawable/ic_menu_help" app:tint="#FF7043" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_marginStart="20dp" android:layout_toEndOf="@id/icon7" android:text="Câu hỏi thường gặp" android:textColor="#444444" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:text="›" android:textColor="#CCCCCC" android:textSize="22sp" />
                </RelativeLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Nhóm 4: Đăng xuất -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="15dp">
                <ImageView android:id="@+id/iconLogout"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerVertical="true"
                    android:src="@android:drawable/ic_lock_power_off"
                    app:tint="#D32F2F" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="20dp"
                    android:layout_toEndOf="@id/iconLogout"
                    android:text="Đăng xuất"
                    android:textColor="#D32F2F"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>