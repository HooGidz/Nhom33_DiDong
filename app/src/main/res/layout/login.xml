<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Phần Header màu tối phía trên -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="#1A1B2E"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đăng nhập"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvSubtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Vui lòng đăng nhập vào tài khoản của bạn!"
        android:textColor="#B0B0B0"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Card chứa Form đăng nhập (bo góc phía trên) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-30dp"
        android:background="@drawable/bg_edittext"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBackground">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMAIL"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:layout_width="match_parent"
            android:id="@+id/edtEmail"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="#F4F7F9"
            android:hint="hoang@gmail.com"
            android:padding="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PASSWORD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:endIconMode="password_toggle"
            app:boxBackgroundMode="none">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="#F4F7F9"
                android:hint="**********"
                android:inputType="textPassword"
                android:padding="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ghi nhớ đăng nhập"
                android:textColor="#A0A0A0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Quên mật khẩu"
                android:textColor="#FF7A28" />
        </RelativeLayout>

        <Button
            android:layout_width="match_parent"
            android:id="@+id/btnLogin"
            android:layout_height="60dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#FF7A28"
            android:text="ĐĂNG NHẬP"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bạn chưa có tài khoản? "
                android:textColor="#808080" />

            <TextView
                android:linksClickable="true"
                android:id="@+id/txtSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐĂNG KÝ"
                android:textColor="#FF7A28"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="Hoặc" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnGoogle"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_margin="8dp"
                app:backgroundTint="@color/white"
                android:src="@drawable/google_icon"
                android:scaleType="centerInside"
                android:padding="12dp"/>

            <ImageButton
                android:id="@+id/btnFacebook"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_margin="8dp"
                app:backgroundTint="#3B5998"
                android:src="@drawable/icon_face"
                android:scaleType="centerInside"
                android:padding="12dp"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btnApple"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_margin="8dp"
                app:backgroundTint="#1A1B2E"
                android:src="@drawable/apple_icon"
                android:scaleType="centerInside"
                android:padding="12dp"
                app:tint="@android:color/white" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>