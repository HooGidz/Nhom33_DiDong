<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- 1. Header & Pizza (Đã đảo ImageView xuống dưới để nổi lên trên) -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@drawable/bg_circle_back"
                android:src="@drawable/baseline_arrow_back_ios_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/orangeBg"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_orange_card"
                app:layout_constraintTop_toBottomOf="@id/btnBack"
                tools:layout_editor_absoluteX="20dp" />

            <LinearLayout
                android:id="@+id/layoutShop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_white_outline"
                android:paddingHorizontal="15dp"
                android:paddingVertical="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/orangeBg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uttora Coffe House"
                    android:textColor="#000" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:src="@drawable/pizza_img"
                android:elevation="10dp"
                app:layout_constraintBottom_toBottomOf="@id/orangeBg"
                app:layout_constraintEnd_toEndOf="@id/orangeBg"
                app:layout_constraintStart_toStartOf="@id/orangeBg"
                app:layout_constraintTop_toTopOf="@id/orangeBg" />

            <!-- 2. Thông tin tên món -->
            <TextView
                android:id="@+id/tvMainTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp"
                android:text="Pizza Calzone kiểu Âu"
                android:textColor="#181C2E"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/layoutShop" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Prosciutto e funghi là một loại pizza được phủ sốt cà chua.."
                android:textColor="#828282"
                app:layout_constraintTop_toBottomOf="@id/tvMainTitle" />

            <!-- KHUNG ĐEN 1: Rating, Shipping, Time -->
            <LinearLayout
                android:id="@+id/layoutInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvDescription">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_star" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" 4.7"
                    android:textStyle="bold"
                    android:textColor="#000"
                    android:layout_marginEnd="20dp"/>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_delivery" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Miễn phí"
                    android:layout_marginEnd="20dp"/>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_clock" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" 20 phút" />
            </LinearLayout>

            <!-- Chọn Size -->
            <TextView
                android:id="@+id/tvSizeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Kích thước:"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutInfo" />

            <LinearLayout
                android:id="@+id/layoutSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvSizeLabel">
                <TextView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:background="@drawable/bg_circle_back"
                    android:gravity="center"
                    android:text="10'" />
                <TextView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@drawable/bg_orange_button"
                    android:gravity="center"
                    android:text="14'"
                    android:textColor="#FFF" />
                <TextView
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:background="@drawable/bg_circle_back"
                    android:gravity="center"
                    android:text="16'" />
            </LinearLayout>

            <!-- KHUNG ĐEN 2: Ingredients -->
            <TextView
                android:id="@+id/tvIngreLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="NGUYÊN LIỆU"
                android:textSize="12sp"
                android:textColor="#828282"
                app:layout_constraintTop_toBottomOf="@id/layoutSize"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvIngreLabel">

                <ImageView android:layout_width="50dp" android:layout_height="50dp" android:padding="12dp" android:layout_marginEnd="15dp" android:background="@drawable/bg_pink_circle" android:src="@drawable/ic_salt" />
                <ImageView android:layout_width="50dp" android:layout_height="50dp" android:padding="12dp" android:layout_marginEnd="15dp" android:background="@drawable/bg_pink_circle" android:src="@drawable/ic_chicken" />
                <ImageView android:layout_width="50dp" android:layout_height="50dp" android:padding="12dp" android:layout_marginEnd="15dp" android:background="@drawable/bg_pink_circle" android:src="@drawable/ic_onion" />
                <ImageView android:layout_width="50dp" android:layout_height="50dp" android:padding="12dp" android:layout_marginEnd="15dp" android:background="@drawable/bg_pink_circle" android:src="@drawable/ic_garlic" />
                <ImageView android:layout_width="50dp" android:layout_height="50dp" android:padding="12dp" android:background="@drawable/bg_pink_circle" android:src="@drawable/ic_chili" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Bottom Bar (Giá tiền & Số lượng) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="#F8F9FA"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="0dp">

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="32.000 VNĐ"
            android:textColor="#181C2E"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_quantity_control"
            android:gravity="center"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0">

            <ImageButton
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_minus"
                app:tint="#FFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:text="2"
                android:textColor="#FFF"
                android:textSize="20sp" />

            <ImageButton
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_input_add"
                app:tint="#FFF" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_add_to_cart"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:backgroundTint="#ff7622"
            android:text="THÊM VÀO GIỎ"
            android:textSize="18dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>