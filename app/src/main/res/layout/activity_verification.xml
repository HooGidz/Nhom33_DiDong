<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121223"> <!-- Màu nền tối của header -->

    <!-- Nút Back -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_margin="20dp"
        android:background="@drawable/bg_circle_back"
        android:src="@drawable/baseline_arrow_back_ios_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tiêu đề Verification -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="XÁC THỰC"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <TextView
        android:id="@+id/tvSubTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Chúng tôi đã gửi mã đến email của bạn: example@gmail.com"
        android:textColor="#D3D1D8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Card trắng bên dưới -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_white_card_top_rounded"
        android:padding="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubTitle">

        <TextView
            android:id="@+id/labelCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NHẬP MÃ XÁC THỰC"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btnResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gửi lại sau 52s"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Các ô nhập mã OTP -->
        <LinearLayout
            android:id="@+id/layoutOtp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/labelCode">

            <EditText android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="8dp" android:background="@drawable/bg_otp_box" android:gravity="center" android:inputType="number" android:text="2" android:textSize="22sp" android:textStyle="bold" />
            <EditText android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="8dp" android:background="@drawable/bg_otp_box" android:gravity="center" android:inputType="number" android:text="0" android:textSize="22sp" android:textStyle="bold" />
            <EditText android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="8dp" android:background="@drawable/bg_otp_box" android:gravity="center" android:inputType="number" android:text="1" android:textSize="22sp" android:textStyle="bold" />
            <EditText android:layout_width="65dp" android:layout_height="65dp" android:layout_margin="8dp" android:background="@drawable/bg_otp_box" android:gravity="center" android:inputType="number" android:text="5" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="35dp"
            android:backgroundTint="#FF7A30"
            android:text="XÁC NHẬN"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/layoutOtp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>