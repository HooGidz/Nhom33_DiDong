<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#FFFFFF"
    android:layout_marginTop="50dp"
    >

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_button_back"
        android:src="@drawable/icons8_back_24"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Card"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333"
        android:layout_marginStart="15dp"
        app:layout_constraintTop_toTopOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toEndOf="@id/btn_back" />

    <TextView
        android:id="@+id/labelName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CARD HOLDER NAME"
        android:textSize="12sp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etHolderName"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Vishal Khadok"
        android:background="@drawable/bg_input_field"
        android:padding="15dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/labelName" />

    <TextView
        android:id="@+id/labelNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CARD NUMBER"
        android:textSize="12sp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/etHolderName"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/etCardNumber"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="2134 ____ ____ ____"
        android:inputType="number"
        android:background="@drawable/bg_input_field"
        android:padding="15dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/labelNumber" />

    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/etCardNumber">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EXPIRE DATE" android:textSize="12sp"/>
            <EditText
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="mm/yyyy"
                android:inputType="datetime"
                android:background="@drawable/bg_input_field"
                android:padding="15dp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CVC" android:textSize="12sp"/>
            <EditText
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:hint="***"
                android:inputType="numberPassword"
                android:background="@drawable/bg_input_field"
                android:padding="15dp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Thêm &amp; Thanh Toán"
        android:backgroundTint="#FF7A33"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>