    <!-- Độ bo tròn của góc (12dp giúp góc trông mềm mại) -->
    <corners android:radius="25dp" />

    <!-- Bạn có thể thêm đường viền nếu muốn (tùy chọn) -->
    <!-- <stroke android:width="1dp" android:color="#E0E0E0" /> -->

    <!-- Khoảng cách giữa nội dung và viền -->
    <padding
        android:left="16dp"
        android:right="16dp"
        android:top="12dp"
        android:bottom="12dp" />
</shape>